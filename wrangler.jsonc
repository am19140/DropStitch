// Cloudflare Worker that serves the DropStitch website at dropstitch.io: the landing page,
// the privacy policy and the "email confirmed" page, all plain files in ./website (no build step).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dropstitch",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./website",
    // /privacy serves privacy.html, /confirmed serves confirmed.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
